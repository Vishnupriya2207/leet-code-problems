
import java.util.*;

class Solution {
    public boolean validPath(int n, int[][] edges, int s, int d) {
        List<Integer>[] g = new ArrayList[n];
        for(int i=0;i<n;i++) g[i]=new ArrayList<>();
        for(int[] e:edges) {
            g[e[0]].add(e[1]);
            g[e[1]].add(e[0]);
        }
        boolean[] v=new boolean[n];
        Stack<Integer> st=new Stack<>();
        st.push(s);
        while(!st.isEmpty()) {
            int x=st.pop();
            if(x==d) return true;
            if(v[x]) continue;
            v[x]=true;
            for(int y:g[x]) if(!v[y]) st.push(y);
        }
        return false;
    }
}
