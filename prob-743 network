class Solution {
    public int networkDelayTime(int[][] times, int n, int k) {
        int[] d = new int[n + 1];
        Arrays.fill(d, Integer.MAX_VALUE);
        d[k] = 0;

        for (int i = 0; i < n; i++) {
            for (int[] e : times) {
                if (d[e[0]] != Integer.MAX_VALUE &&
                    d[e[0]] + e[2] < d[e[1]]) {
                    d[e[1]] = d[e[0]] + e[2];
                }
            }
        }

        int max = 0;
        for (int i = 1; i <= n; i++) {
            if (d[i] == Integer.MAX_VALUE) return -1;
            max = Math.max(max, d[i]);
        }
        return max;
    }
}
