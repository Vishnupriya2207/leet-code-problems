
class Solution {
    int d = 0;
    public int diameterOfBinaryTree(TreeNode root) {
        height(root);
        return d;
    }
    int height(TreeNode n) {
        if (n == null) return 0;
        int l = height(n.left), r = height(n.right);
        d = Math.max(d, l + r);
        return 1 + Math.max(l, r);
    }
}
