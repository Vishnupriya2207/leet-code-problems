class Solution {
    public int lastStoneWeightII(int[] stones) {
        int sum = 0;
        for (int n : stones) sum += n;
        boolean[] dp = new boolean[sum / 2 + 1];
        dp[0] = true;
        for (int n : stones)
            for (int j = sum / 2; j >= n; j--)
                dp[j] |= dp[j - n];
        for (int j = sum / 2; j >= 0; j--)
            if (dp[j]) return sum - 2 * j;
        return 0;
    }
}
