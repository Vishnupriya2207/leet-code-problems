class Solution {
    public double maxProbability(int n, int[][] edges,
            double[] prob, int start, int end) {
        double[] d = new double[n];
        d[start] = 1;

        for (int i = 0; i < n; i++) {
            boolean change = false;
            for (int j = 0; j < edges.length; j++) {
                int a = edges[j][0], b = edges[j][1];
                if (d[a] * prob[j] > d[b]) {
                    d[b] = d[a] * prob[j];
                    change = true;
                }
                if (d[b] * prob[j] > d[a]) {
                    d[a] = d[b] * prob[j];
                    change = true;
                }
            }
            if (!change) break;
        }
        return d[end];
    }
}
