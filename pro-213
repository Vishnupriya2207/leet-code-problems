
class Solution {
    public int rob(int[] a) {
        if (a.length == 1) return a[0];
        return Math.max(rob(a, 0, a.length-2), rob(a, 1, a.length-1));
    }
    int rob(int[] a, int l, int r) {
        int p=0, c=0;
        for(int i=l;i<=r;i++) {
            int t=c;
            c=Math.max(c,p+a[i]);
            p=t;
        }
        return c;
    }
}
