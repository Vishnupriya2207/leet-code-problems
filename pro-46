
import java.util.*;

class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        back(nums, 0, ans);
        return ans;
    }
    void back(int[] a, int i, List<List<Integer>> ans) {
        if(i == a.length) {
            List<Integer> l = new ArrayList<>();
            for(int n : a) l.add(n);
            ans.add(l);
            return;
        }
        for(int j=i; j<a.length; j++) {
            int t=a[i]; a[i]=a[j]; a[j]=t;
            back(a, i+1, ans);
            t=a[i]; a[i]=a[j]; a[j]=t;
        }
    }
}
