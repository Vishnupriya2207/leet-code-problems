class Solution {
    public int shortestPathBinaryMatrix(int[][] grid) {
        int n = grid.length;
        if (grid[0][0] == 1 || grid[n-1][n-1] == 1) return -1;
        Queue<int[]> q = new LinkedList<>();
        q.add(new int[]{0, 0, 1});
        grid[0][0] = 1;
        while (!q.isEmpty()) {
            int[] c = q.poll();
            int r = c[0], col = c[1], len = c[2];
            if (r == n-1 && col == n-1) return len;
            for (int i = -1; i <= 1; i++)
                for (int j = -1; j <= 1; j++) {
                    int a = r+i, b = col+j;
                    if (a>=0 && b>=0 && a<n && b<n && grid[a][b]==0) {
                        grid[a][b] = 1;
                        q.add(new int[]{a, b, len+1});
                    }
                }
        }
        return -1;
    }
}
