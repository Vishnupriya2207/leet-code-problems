class Solution {
    public boolean canFinish(int n, int[][] p) {
        int[] d = new int[n];
        List<List<Integer>> g = new ArrayList<>();

        for (int i = 0; i < n; i++)
            g.add(new ArrayList<>());

        for (int[] e : p) {
            g.get(e[1]).add(e[0]);
            d[e[0]]++;
        }

        Queue<Integer> q = new LinkedList<>();
        for (int i = 0; i < n; i++)
            if (d[i] == 0) q.add(i);

        int count = 0;
        while (!q.isEmpty()) {
            int u = q.poll();
            count++;
            for (int v : g.get(u))
                if (--d[v] == 0) q.add(v);
        }
        return count == n;
    }
}
